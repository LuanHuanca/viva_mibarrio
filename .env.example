# Copia a .env — no subas .env a GitHub

# PostgreSQL (Docker: pnpm db:docker)
DATABASE_URL="postgresql://postgres:viva_dev_password@localhost:5433/viva_barrio"

# NextAuth — genera con: npx auth secret
AUTH_SECRET=""

# Discord (opcional)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# QR dinámico (mín. 16 caracteres)
QR_SIGNING_SECRET="cambiar-en-produccion-min-32-chars!!"

# Negocio
META_USUARIOS_DEFAULT=30
QR_TTL_SECONDS=10
AD_MIN_SECONDS=10

# Asistente WhatsApp (número VIVA con código país, ej. 59170009999)
WHATSAPP_ASISTENTE_PHONE=
# Webhook Meta Cloud API (opcional — chatbot automático)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Mapa (fase Leaflet)
NEXT_PUBLIC_MAP_CENTER_LAT=-17.3895
NEXT_PUBLIC_MAP_CENTER_LNG=-66.1568

# ——— AWS (solo producción; ver .cursor/09-aws-variables.md) ———
